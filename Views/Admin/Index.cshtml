@model AdminIndexVM
@{
    ViewData["Title"] = "لوحة الإدارة";
    var tabs = new (ListingStatus S, string L)[]
    {
        (ListingStatus.PendingReview, "قيد المراجعة"), (ListingStatus.Published, "منشور"),
        (ListingStatus.Rejected, "مرفوض"), (ListingStatus.Sold, "تم البيع"), (ListingStatus.Closed, "متوقف")
    };
}
<h1 class="h4 mb-3">لوحة الإدارة - الإعلانات</h1>
<ul class="nav nav-pills mb-3">
    @foreach (var t in tabs)
    {
        Model.Counts.TryGetValue(t.S, out var n);
        <li class="nav-item">
            <a class="nav-link @(Model.Status == t.S ? "active" : "")" asp-action="Index" asp-route-status="@t.S">
                @t.L <span class="badge bg-light text-dark">@n</span>
            </a>
        </li>
    }
</ul>

@if (!Model.Rows.Any())
{
    <div class="alert alert-light border text-center py-4">مفيش إعلانات هنا.</div>
}
@foreach (var r in Model.Rows)
{
    <div class="card border-0 shadow-sm mb-2">
        <div class="card-body d-flex flex-wrap gap-3 align-items-center">
            @if (r.MainImage != null)
            {
                <img src="@r.MainImage" alt="" style="width:90px;height:72px;object-fit:cover;border-radius:8px" />
            }
            <div class="flex-grow-1">
                <div class="fw-semibold">@r.Title @(r.IsFeatured ? "⭐" : "")</div>
                <div class="small text-muted">@r.CategoryName - @r.SellerName - @r.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                <div class="price">@r.Price.ToString("N0") ج.م@(r.PricingType == PricingType.PerKg ? " / كيلو" : "")</div>
            </div>
            <a asp-action="Review" asp-route-id="@r.Id" class="btn btn-success btn-sm">مراجعة</a>
        </div>
    </div>
}

<partial name="_Pager" model="Model.Pager" />
