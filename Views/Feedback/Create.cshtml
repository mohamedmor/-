@model FeedbackFormVM
@{ ViewData["Title"] = "رأيك في الموقع"; }
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm p-4">
            <h1 class="h4 mb-1">رأيك في الموقع</h1>
            <p class="text-muted">قولّنا إيه اللي عاجبك وإيه اللي محتاج يتحسّن. بنقرا كل رأي.</p>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label class="form-label d-block">تقييمك للموقع</label>
                    <partial name="_StarInput" model="Model.Rating" />
                    <span asp-validation-for="Rating" class="text-danger small d-block"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Kind" class="form-label"></label>
                    <select asp-for="Kind" class="form-select">
                        <option value="1" selected="@(Model.Kind == FeedbackKind.Praise)">إعجاب</option>
                        <option value="2" selected="@(Model.Kind == FeedbackKind.Suggestion)">اقتراح</option>
                        <option value="3" selected="@(Model.Kind == FeedbackKind.Problem)">مشكلة</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="Message" class="form-label"></label>
                    <textarea asp-for="Message" class="form-control" rows="5" maxlength="1000"></textarea>
                    <span asp-validation-for="Message" class="text-danger small"></span>
                </div>
                <button class="btn btn-success px-4">إرسال</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-link">إلغاء</a>
            </form>
        </div>
    </div>
</div>
