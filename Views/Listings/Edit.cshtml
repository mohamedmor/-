@model ListingFormVM
@{ ViewData["Title"] = "تعديل الإعلان"; }
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h4 mb-3">تعديل الإعلان</h1>
        <div class="alert alert-warning small">بعد حفظ التعديل الإعلان بيرجع للمراجعة قبل ما يظهر للناس تاني.</div>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-success px-4">حفظ</button>
            <a asp-action="My" class="btn btn-link">إلغاء</a>
        </form>
    </div>
</div>
@section Scripts { <script src="~/js/listing-form.js" asp-append-version="true"></script> }
