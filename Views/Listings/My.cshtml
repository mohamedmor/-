@model MyListingsVM
@{
    ViewData["Title"] = "إعلاناتي";
    string Label(ListingStatus s) => s switch
    {
        ListingStatus.PendingReview => "قيد المراجعة",
        ListingStatus.Published => "منشور",
        ListingStatus.Rejected => "مرفوض",
        ListingStatus.Reserved => "محجوز",
        ListingStatus.Sold => "تم البيع",
        _ => "متوقف"
    };
    string Color(ListingStatus s) => s switch
    {
        ListingStatus.PendingReview => "warning text-dark",
        ListingStatus.Published => "success",
        ListingStatus.Rejected => "danger",
        ListingStatus.Reserved => "info text-dark",
        ListingStatus.Sold => "secondary",
        _ => "secondary"
    };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">إعلاناتي</h1>
    <a asp-action="Create" class="btn btn-success">+ أضف إعلان</a>
</div>

@if (!Model.Items.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted">لسه معندكش إعلانات. اضغط "أضف إعلان" وابدأ.</div>
}

@foreach (var l in Model.Items)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap gap-3 align-items-center">
            @if (l.MainImage != null)
            {
                <img src="@l.MainImage" alt="" style="width:110px;height:90px;object-fit:cover;border-radius:8px" />
            }
            else
            {
                <div class="noimg" style="width:110px;height:90px;border-radius:8px">-</div>
            }
            <div class="flex-grow-1">
                <a asp-action="Details" asp-route-id="@l.Id" class="fw-semibold text-decoration-none">@l.Title</a>
                <div class="price">@l.Price.ToString("N0") ج.م@(l.PricingType == PricingType.PerKg ? " / كيلو" : "")</div>
                <div class="small">العدد المتاح: <strong>@l.Quantity</strong></div>
                <div class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd") - مشاهدات: @l.ViewsCount</div>
                <span class="badge bg-@Color(l.Status)">@Label(l.Status)</span>
                @if (l.Status == ListingStatus.Rejected && !string.IsNullOrEmpty(l.RejectionReason))
                {
                    <div class="small text-danger mt-1">سبب الرفض: @l.RejectionReason</div>
                }
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (l.Status != ListingStatus.Sold && l.Status != ListingStatus.Closed)
                {
                    <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
                    <form asp-action="UpdateQuantity" asp-route-id="@l.Id" method="post" class="d-flex gap-1"
                          title="اكتب العدد اللي فاضل بعد البيع. لو صفر، الإعلان بيتحدد تم البيع.">
                        <input type="number" name="quantity" min="0" max="1000" value="@l.Quantity" class="form-control form-control-sm" style="width:78px" aria-label="العدد المتاح" />
                        <button class="btn btn-outline-secondary btn-sm">تحديث العدد</button>
                    </form>
                    <form asp-action="MarkSold" asp-route-id="@l.Id" method="post"><button class="btn btn-outline-success btn-sm">تم بيع الكل</button></form>
                    <form asp-action="Close" asp-route-id="@l.Id" method="post"><button class="btn btn-outline-secondary btn-sm">إيقاف</button></form>
                }
                <form asp-action="Delete" asp-route-id="@l.Id" method="post" onsubmit="return confirm('متأكد إنك عايز تحذف الإعلان نهائياً؟');">
                    <button class="btn btn-outline-danger btn-sm">حذف</button>
                </form>
            </div>
        </div>
    </div>
}

<partial name="_Pager" model="Model.Pager" />
