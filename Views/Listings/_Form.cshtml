@model ListingFormVM
@{
    var edit = Model.Id != null;
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="card border-0 shadow-sm p-4 mb-3">
    <h2 class="h6 text-muted mb-3">بيانات الحيوان</h2>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="مثال: بقرة حلابة فريزيان" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-select">
                <option value="0">اختر القسم</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ConditionId" class="form-label"></label>
            <select asp-for="ConditionId" class="form-select">
                <option value="">بدون / غير محدد</option>
                @foreach (var c in Model.Conditions)
                {
                    <option value="@c.Id" selected="@(c.Id == Model.ConditionId)">@c.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select">
                <option value="">غير محدد</option>
                <option value="1" selected="@(Model.Gender == Gender.Male)">ذكر</option>
                <option value="2" selected="@(Model.Gender == Gender.Female)">أنثى</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="AgeMonths" class="form-label"></label>
            <input asp-for="AgeMonths" class="form-control" type="number" min="0" />
            <span asp-validation-for="AgeMonths" class="text-danger small"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="WeightKg" class="form-label"></label>
            <input asp-for="WeightKg" class="form-control" type="number" step="0.1" min="1" />
            <span asp-validation-for="WeightKg" class="text-danger small"></span>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 mb-3">
    <h2 class="h6 text-muted mb-3">السعر</h2>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="PricingType" class="form-label"></label>
            <select asp-for="PricingType" class="form-select" id="pricingType">
                <option value="1" selected="@(Model.PricingType == PricingType.Fixed)">سعر ثابت للحيوان (حلاب / تربية / أليف)</option>
                <option value="2" selected="@(Model.PricingType == PricingType.PerKg)">بالكيلو (للذبح / اللحم)</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Price" class="form-label"><span id="priceLabel">السعر (ج.م)</span></label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="1" />
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-1">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" type="number" min="1" max="1000" />
            <span asp-validation-for="Quantity" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-1 d-flex align-items-end">
            <div class="form-text mb-2">عندك أكتر من حيوان من نفس النوع وبنفس السعر؟ اكتب العدد، وإعلان واحد يكفي. السعر بيبقى للحيوان الواحد.</div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 mb-3">
    <h2 class="h6 text-muted mb-3">المكان</h2>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Governorate" class="form-label"></label>
            <select asp-for="Governorate" class="form-select">
                <option value="">اختر المحافظة</option>
                @foreach (var g in LivestockMarket.Utilities.Egypt.Governorates)
                {
                    <option value="@g" selected="@(g == Model.Governorate)">@g</option>
                }
            </select>
            <span asp-validation-for="Governorate" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 mb-3">
    <h2 class="h6 text-muted mb-1">تفاصيل إضافية (من عندك)</h2>
    <p class="small text-muted">زي: كمية اللبن في اليوم، حالة المولود، التحصينات، الحالة الصحية ... اكتب اللي يهم المشتري.</p>
    <div id="attrs">
        @for (var i = 0; i < Model.Attributes.Count; i++)
        {
            <div class="row g-2 mb-2 attr-row">
                <div class="col-5"><input name="Attributes[@i].Name" value="@Model.Attributes[i].Name" class="form-control" placeholder="الاسم (مثال: اللبن يومياً)" maxlength="60" /></div>
                <div class="col-5"><input name="Attributes[@i].Value" value="@Model.Attributes[i].Value" class="form-control" placeholder="القيمة (مثال: 18 لتر)" maxlength="200" /></div>
                <div class="col-2"><button type="button" class="btn btn-outline-danger w-100 remove-attr">حذف</button></div>
            </div>
        }
    </div>
    <div><button type="button" class="btn btn-outline-success btn-sm" id="addAttr">+ أضف تفصيلة</button></div>

    <div class="mt-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 mb-3">
    <h2 class="h6 text-muted mb-1">الصور</h2>
    <p class="small text-muted">حتى 6 صور، كل صورة لحد 5 ميجا (jpg / png / webp). أول صورة هي الرئيسية.</p>
    @if (edit && Model.ExistingImages.Any())
    {
        <div class="d-flex flex-wrap gap-3 mb-3">
            @foreach (var img in Model.ExistingImages)
            {
                <label class="text-center small">
                    <img src="@img.FilePath" alt="" style="width:110px;height:90px;object-fit:cover;border-radius:8px" /><br />
                    <input type="checkbox" name="RemoveImageIds" value="@img.Id" /> حذف
                </label>
            }
        </div>
    }
    <input type="file" name="NewImages" class="form-control" accept=".jpg,.jpeg,.png,.webp" multiple />
    <span asp-validation-for="NewImages" class="text-danger small"></span>
</div>
