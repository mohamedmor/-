@model List<ReportRowVM>
@{
    ViewData["Title"] = "البلاغات";
    var status = (ReportStatus)ViewData["Status"]!;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">البلاغات</h1>
    <div class="d-flex gap-2">
        <a asp-action="ChatReports" class="btn btn-outline-danger btn-sm">بلاغات المحادثات</a>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-link btn-sm">&larr; الإعلانات</a>
    </div>
</div>
<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(status == ReportStatus.Open ? "active" : "")" asp-action="Reports" asp-route-status="Open">مفتوحة</a></li>
    <li class="nav-item"><a class="nav-link @(status == ReportStatus.Resolved ? "active" : "")" asp-action="Reports" asp-route-status="Resolved">تم التعامل</a></li>
    <li class="nav-item"><a class="nav-link @(status == ReportStatus.Dismissed ? "active" : "")" asp-action="Reports" asp-route-status="Dismissed">مرفوضة</a></li>
</ul>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-4">مفيش بلاغات هنا.</div>
}
@foreach (var r in Model)
{
    <div class="card border-0 shadow-sm mb-2">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div>
                    <span class="badge bg-danger">@ReportText.Reason(r.Reason)</span>
                    <a asp-controller="Admin" asp-action="Review" asp-route-id="@r.ListingId" class="fw-semibold ms-2">@r.ListingTitle</a>
                    <span class="badge bg-secondary">@r.ListingStatus</span>
                    <div class="small text-muted mt-1">
                        البائع: @r.SellerName - المبلّغ: @r.ReporterName - @r.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    </div>
                    @if (!string.IsNullOrEmpty(r.Details))
                    {
                        <div class="mt-1">@r.Details</div>
                    }
                </div>
                @if (r.Status == ReportStatus.Open)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-start">
                        <a asp-controller="Admin" asp-action="Review" asp-route-id="@r.ListingId" class="btn btn-outline-primary btn-sm">فحص الإعلان</a>
                        <form asp-action="Resolve" asp-route-id="@r.Id" method="post"><button class="btn btn-success btn-sm">تم التعامل</button></form>
                        <form asp-action="Dismiss" asp-route-id="@r.Id" method="post"><button class="btn btn-outline-secondary btn-sm">تجاهل</button></form>
                        @if (r.SellerBlocked)
                        {
                            <span class="badge bg-dark align-self-center">البائع محظور</span>
                        }
                        else
                        {
                            <form asp-action="ToggleBlock" asp-route-id="@r.SellerId" method="post" onsubmit="return confirm('حظر البائع ده وإيقاف كل إعلاناته؟');">
                                <button class="btn btn-outline-danger btn-sm">حظر البائع</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
