@model List<UserRowVM>
@{ ViewData["Title"] = "المستخدمين"; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h4 mb-0">المستخدمين</h1>
    <form method="get" asp-action="Users" class="d-flex gap-2">
        <input name="q" value="@ViewData["Q"]" class="form-control form-control-sm" placeholder="اسم / إيميل / موبايل" />
        <button class="btn btn-success btn-sm">بحث</button>
    </form>
</div>
<div class="table-responsive card border-0 shadow-sm">
    <table class="table table-sm align-middle mb-0">
        <thead><tr><th>الاسم</th><th>الإيميل</th><th>الموبايل</th><th>إعلانات</th><th>بلاغات ضده</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName @(u.IsAdmin ? "(مدير)" : "")</td>
                    <td dir="ltr" class="text-start">@u.Email</td>
                    <td dir="ltr" class="text-start">@u.Phone</td>
                    <td>@u.ListingsCount</td>
                    <td>@(u.ReportsAgainst > 0 ? Html.Raw("<span class='text-danger fw-bold'>" + u.ReportsAgainst + "</span>") : Html.Raw("0"))</td>
                    <td>@(u.IsBlocked ? "محظور" : "نشط")</td>
                    <td>
                        @if (!u.IsAdmin)
                        {
                            <form asp-action="ToggleBlock" asp-route-id="@u.Id" method="post"
                                  onsubmit="return confirm('@(u.IsBlocked ? "فك الحظر؟" : "حظر المستخدم وإيقاف إعلاناته؟")');">
                                <button class="btn btn-sm @(u.IsBlocked ? "btn-outline-success" : "btn-outline-danger")">@(u.IsBlocked ? "فك الحظر" : "حظر")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
