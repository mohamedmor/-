@using LivestockMarket.Utilities
@{ ViewData["Title"] = "من نحن"; }
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm p-4 p-md-5">
            <h1 class="mb-3">من نحن</h1>
            <p class="lead">@SiteInfo.Name سوق مفتوح لبيع وشراء المواشي والحيوانات الأليفة في مصر. أي حد يقدر يعرض حيوان للبيع، وأي حد يقدر يتصفح ويتواصل مع البائع مباشرة.</p>

            <h2 class="h5 mt-4">إزاي بيشتغل الموقع؟</h2>
            <ul class="mb-3">
                <li><strong>البائع</strong> بيضيف إعلان بالصور والسعر (سعر ثابت أو بالكيلو للذبح) والتفاصيل اللي تهم المشتري.</li>
                <li><strong>الإدارة</strong> بتراجع الإعلان قبل ما يظهر للناس.</li>
                <li><strong>المشتري</strong> بيتصفح ويفلتر، ويراسل البائع ويتفقوا على السعر والتوصيل بينهم مباشرة.</li>
                <li>بعد التعامل، المشتري يقدر يقيّم البائع، وتقييمه بيظهر في صفحة البائع.</li>
            </ul>

            <h2 class="h5 mt-4">نصايح للأمان</h2>
            <ul class="mb-3">
                <li>شوف الحيوان بنفسك قبل ما تدفع أي مبلغ.</li>
                <li>متحوّلش فلوس مقدماً لحد متعرفوش.</li>
                <li>اتأكد من حالة الحيوان الصحية، واطلب شهادة تحصينات لو متاحة.</li>
                <li>لو شفت إعلان أو شخص مشبوه، استخدم زرار "بلّغ" وهنراجعه.</li>
            </ul>

            <p class="text-muted small mb-0">
                الموقع وسيط بين البائع والمشتري، والاتفاق على السعر والتوصيل والاستلام بين الطرفين.
            </p>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-controller="Contact" asp-action="Index" class="btn btn-success">تواصل مع الإدارة</a>
                <a asp-controller="Feedback" asp-action="Create" class="btn btn-outline-success">رأيك في الموقع</a>
            </div>
        </div>
    </div>
</div>
