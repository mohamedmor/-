@model ReviewFormVM
@{ ViewData["Title"] = "قيّم البائع"; }
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 shadow-sm p-4">
            <h1 class="h5 mb-1">@(Model.IsEdit ? "عدّل تقييمك" : "قيّم البائع")</h1>
            <p class="text-muted mb-3">@Model.SellerName</p>
            <form asp-action="Seller" method="post">
                <input type="hidden" asp-for="SellerId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label class="form-label d-block">تقييمك</label>
                    <partial name="_StarInput" model="Model.Rating" />
                    <span asp-validation-for="Rating" class="text-danger small d-block"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Comment" class="form-label"></label>
                    <textarea asp-for="Comment" class="form-control" rows="4" maxlength="500" placeholder="حكاية تعاملك معاه: صدق الإعلان، الالتزام، المعاملة..."></textarea>
                    <span asp-validation-for="Comment" class="text-danger small"></span>
                </div>
                <button class="btn btn-success px-4">@(Model.IsEdit ? "حفظ التعديل" : "إرسال التقييم")</button>
                <a asp-controller="Sellers" asp-action="Profile" asp-route-id="@Model.SellerId" class="btn btn-link">إلغاء</a>
            </form>
        </div>
    </div>
</div>
