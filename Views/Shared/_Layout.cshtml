<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - سوق المواشي</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Readex+Pro:wght@300;400;500;600&display=swap" />
    <script>document.documentElement.classList.add('js')</script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <meta name="theme-color" content="#2f6b3a" />
    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var ctrlName = ViewContext.RouteData.Values["controller"]?.ToString();
        var inAdmin = (ctrlName == "Admin" || ctrlName == "Moderation") && User.IsInRole("Admin");
    }
    <header class="site-header">
    <nav class="navbar navbar-expand-md navbar-dark site-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">سوق المواشي</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Market" asp-action="Index">تصفح</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Listings" asp-action="Create">+ أضف إعلان</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Listings" asp-action="My">إعلاناتي</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Messages" asp-action="Inbox">الرسائل @await Component.InvokeAsync("UnreadMessages")</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link text-warning" asp-controller="Admin" asp-action="Index">الإدارة</a></li>
                        }
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Profile" asp-action="Index" class="text-white small text-decoration-none">حسابي</a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">تسجيل الخروج</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                        <a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">حساب جديد</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    @if (inAdmin)
    {
        @await Component.InvokeAsync("AdminNav")
    }
    </header>

    <main class="container py-4">
        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-4 border-top">
        <div class="d-flex flex-wrap justify-content-center gap-3 mb-2">
            <a asp-controller="Pages" asp-action="About" class="text-muted">من نحن</a>
            <a asp-controller="Feedback" asp-action="Create" class="text-muted">رأيك في الموقع</a>
            <a asp-controller="Contact" asp-action="Index" class="text-muted">تواصل مع الإدارة</a>
        </div>
        سوق المواشي &copy; @DateTime.Now.Year
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
