@model PagerVM
@if (Model.TotalPages > 1)
{
    Dictionary<string, string?> R(int p)
    {
        var d = new Dictionary<string, string?>(Model.Route);
        d["page"] = p.ToString();
        return d;
    }

    <nav aria-label="التنقل بين الصفحات" class="pager mt-4">
        <div class="text-center small text-muted mb-2">عرض @Model.From - @Model.To من @Model.Total</div>
        <ul class="pagination justify-content-center flex-wrap mb-0">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="R(Model.Page - 1)" rel="prev">السابق</a>
            </li>
            @foreach (var p in Model.Window())
            {
                if (p == 0)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")" aria-current="@(p == Model.Page ? "page" : null)">
                        <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="R(p)">@p</a>
                    </li>
                }
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="R(Model.Page + 1)" rel="next">التالي</a>
            </li>
        </ul>
    </nav>
}
